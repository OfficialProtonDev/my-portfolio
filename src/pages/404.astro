---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/base';
---

<Base
  title="Nothing here | Billy Hancock"
  description="This page doesn’t exist. Everything Billy Hancock has built is on the home page."
  chrome={false}
  build={false}
  noindex
>
  <main class="lost is-night" data-t0="23.5" data-t1="23.5" style="--fallback:#090e29">
    <div class="wrap lost-inner">
      <p class="chapter-time" aria-hidden="true">11:30 pm</p>
      <h1 class="lost-title">Nothing here.</h1>
      <p class="lost-text">
        Just stars. The address may be mistyped, or the page may have moved. Everything I’ve built is on the home page.
      </p>
      <p><a class="pill-btn" href={withBase()}>Back to the home page</a></p>
    </div>
  </main>

  <script>
    import { initSky } from '../scripts/sky';
    initSky();
  </script>
</Base>

<style>
  .lost {
    min-height: 100svh;
    display: grid;
    align-items: center;
  }

  .lost-inner {
    display: grid;
    gap: 1.5rem;
  }

  .lost-title {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: var(--t-chapter);
    line-height: 0.9;
    letter-spacing: -0.04em;
    margin-left: -0.05em;
  }

  .lost-text {
    max-width: 30em;
    font-family: var(--serif);
    font-size: var(--t-lede);
    line-height: 1.3;
    color: var(--ink-2);
  }
</style>
