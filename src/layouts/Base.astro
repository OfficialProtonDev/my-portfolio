---
import '../styles/fonts.css';
import '../styles/global.css';
import serifUrl from '../assets/fonts/newsreader-roman.woff2?url';
import serifItalicUrl from '../assets/fonts/newsreader-italic.woff2?url';
import sansUrl from '../assets/fonts/instrument-sans.woff2?url';
import Sky from '../components/Sky.astro';
import Bar from '../components/Bar.astro';
import Rail from '../components/Rail.astro';
import { withBase } from '../lib/base';

interface Props {
  title: string;
  description: string;
  /** The fixed bar and time rail. The 404 page goes without. */
  chrome?: boolean;
  /** Whether a first visit gets the agents' build. */
  build?: boolean;
  noindex?: boolean;
}

const { title, description, chrome = true, build = true, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase('og.png'), Astro.site);
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#7090b4" />
    <meta name="author" content="Billy Hancock" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifItalicUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />

    <!--
      Decide before first paint whether this visit gets the build. The finished
      page is always in the HTML; this only darkens the sky and hides the hero
      until the agents take over, and lifts itself if the build never starts.
    -->
    <script is:inline define:vars={{ build }}>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var detail = localStorage.getItem('bh.detail');
          d.setAttribute('data-detail', detail === 'deep' ? 'deep' : 'short');
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          var seen = localStorage.getItem('bh.run');
          var asked = /[?&]rebuild\b/.test(location.search);
          // Crawlers and audit tools get the finished page straight away.
          var robot = navigator.webdriver || /bot|crawl|spider|slurp|lighthouse|headless/i.test(navigator.userAgent);
          if (build && !reduce && (asked || (!seen && !robot)) && !location.hash) d.classList.add('build-pending');
        } catch (e) {
          d.setAttribute('data-detail', 'short');
        }
        window.setTimeout(function () {
          if (!d.classList.contains('build-running')) d.classList.remove('build-pending');
        }, 3000);
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#day">Skip to the work</a>
    <Sky />
    {chrome && <Bar />}
    {chrome && <Rail />}
    <slot />
  </body>
</html>
