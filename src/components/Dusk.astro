---
import { clockText, hours } from '../lib/sky';

const T0 = 17.5;
const T1 = 20.5;

/*
 * A low city skyline, seeded so it's the same on every build. Each light
 * carries the point in the evening (0 to 1) at which it comes on: street
 * lights first, then the office, then the rest of town.
 */
const W = 1440;
const H = 320;

function rng(seed: number) {
  let s = seed;
  return () => (s = (s * 16807) % 2147483647) / 2147483647;
}

interface Box {
  x: number;
  y: number;
  w: number;
  h: number;
}
interface Light extends Box {
  th: number;
  kind: 'office' | 'town' | 'far';
}

const back: Box[] = [];
const front: Box[] = [];
const roofs: Box[] = [];
const masts: { x: number; y: number; h: number }[] = [];
const lights: Light[] = [];

// Back row: taller and hazier.
{
  const r = rng(77);
  let x = -20;
  while (x < W) {
    const w = 38 + Math.round(r() * 84);
    const tall = r() < 0.18;
    const h = tall ? 170 + Math.round(r() * 90) : 90 + Math.round(r() * 80);
    back.push({ x, y: H - h, w, h: h + 2 });
    for (let c = 0; c < Math.floor((w - 10) / 13); c++) {
      for (let k = 0; k < Math.floor((h - 18) / 17); k++) {
        if (r() < 0.07) lights.push({ x: x + 7 + c * 13, y: H - h + 12 + k * 17, w: 6, h: 7, th: 0.3 + r() * 0.65, kind: 'far' });
      }
    }
    x += w + Math.round(r() * 6);
  }
}

// Front row: lower, darker, with the office lit up in the middle of it.
const OFFICE = { x: 812, w: 184, h: 236 };
{
  const r = rng(20260611);
  let x = -10;
  while (x < W) {
    const isOffice = x <= OFFICE.x && x + 160 > OFFICE.x;
    const w = isOffice ? OFFICE.w : 52 + Math.round(r() * 104);
    const h = isOffice ? OFFICE.h : 60 + Math.round(r() * (r() < 0.25 ? 130 : 80));
    const top = H - h;
    front.push({ x, y: top, w, h: h + 2 });
    if (!isOffice && r() < 0.55) {
      const rw = 10 + Math.round(r() * 22);
      roofs.push({ x: x + 8 + Math.round(r() * Math.max(0, w - rw - 16)), y: top - 6, w: rw, h: 7 });
    }
    if (!isOffice && h > 150 && r() < 0.7) masts.push({ x: x + Math.round(w * (0.3 + r() * 0.4)), y: top, h: 16 + Math.round(r() * 18) });
    const cols = Math.max(1, Math.floor((w - 16) / 18));
    const rows = Math.max(1, Math.floor((h - 24) / 22));
    for (let c = 0; c < cols; c++) {
      for (let k = 0; k < rows; k++) {
        const lit = isOffice ? r() < 0.93 : r() < 0.15;
        if (!lit) continue;
        lights.push({
          x: x + 10 + c * 18,
          y: top + 15 + k * 22,
          w: 9,
          h: 11,
          // The office fills floor by floor from the ground up; the rest of town at random.
          th: isOffice ? 0.05 + ((rows - 1 - k) / rows) * 0.64 + r() * 0.1 : 0.22 + r() * 0.72,
          kind: isOffice ? 'office' : 'town',
        });
      }
    }
    x += w + (r() < 0.3 ? 6 + Math.round(r() * 18) : 2);
  }
}
const office = front.find((b) => b.w === OFFICE.w && b.h === OFFICE.h + 2)!;
const tallest = [...masts].sort((a, b) => a.y - a.h - (b.y - b.h))[0];
const street = Array.from({ length: Math.ceil(W / 46) }, (_, i) => ({ x: 20 + i * 46, th: 0.02 + ((i * 37) % 23) / 100 }));
---

<section class="dusk" id="overnight" aria-labelledby="overnight-title" {...hours(T0, T1)} data-dusk data-live-clock>
  <div class="dusk-stage">
    <div class="wrap dusk-text">
      <p class="chapter-time" aria-hidden="true" data-ink-auto="dusk" data-live-time>{clockText(T0)}</p>
      <h2 class="dusk-title" id="overnight-title" data-ink-auto="dusk">Some days run long.</h2>
      <p class="dusk-story" data-ink-auto="dusk">
        When a critical PHP vulnerability put the SilverStripe sites we look after at risk, I helped patch every one.
        Then we moved them onto newer versions of PHP and SilverStripe overnight, at the&nbsp;office.
      </p>
    </div>

    <svg class="dusk-moon" viewBox="0 0 64 64" aria-hidden="true">
      <defs>
        <mask id="dusk-moon-cut">
          <rect width="64" height="64" fill="#fff"></rect>
          <circle cx="43" cy="25" r="21" fill="#000"></circle>
        </mask>
      </defs>
      <circle cx="32" cy="32" r="21" fill="currentColor" mask="url(#dusk-moon-cut)"></circle>
    </svg>

    <svg class="skyline" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMax slice" aria-hidden="true">
      <defs>
        <radialGradient id="office-glow" cx="50%" cy="58%" r="50%">
          <stop offset="0" stop-color="#ffcf8f" stop-opacity=".42"></stop>
          <stop offset=".3" stop-color="#ffcf8f" stop-opacity=".2"></stop>
          <stop offset=".6" stop-color="#ffcf8f" stop-opacity=".07"></stop>
          <stop offset=".82" stop-color="#ffcf8f" stop-opacity=".02"></stop>
          <stop offset="1" stop-color="#ffcf8f" stop-opacity="0"></stop>
        </radialGradient>
        <radialGradient id="lamp-glow">
          <stop offset="0" stop-color="#ffd59a" stop-opacity=".55"></stop>
          <stop offset="1" stop-color="#ffd59a" stop-opacity="0"></stop>
        </radialGradient>
      </defs>
      <g class="sky-back">
        {back.map((b) => <rect x={b.x} y={b.y} width={b.w} height={b.h} />)}
      </g>
      {lights.filter((l) => l.kind === 'far').map((l) => <rect class="win is-far" x={l.x} y={l.y} width={l.w} height={l.h} style={`--th:${l.th.toFixed(3)}`} />)}
      <ellipse class="office-glow" cx={office.x + office.w / 2} cy={H - office.h * 0.55} rx={office.w * 1.5} ry={office.h * 0.9} fill="url(#office-glow)"></ellipse>
      <g class="sky-front">
        {front.map((b) => <rect x={b.x} y={b.y} width={b.w} height={b.h} />)}
        {roofs.map((b) => <rect x={b.x} y={b.y} width={b.w} height={b.h} />)}
        {masts.map((m) => <rect x={m.x} y={m.y - m.h} width="1.5" height={m.h} />)}
      </g>
      {tallest && <circle class="mast-light" cx={tallest.x + 0.75} cy={tallest.y - tallest.h} r="2.2"></circle>}
      {
        lights
          .filter((l) => l.kind !== 'far')
          .map((l) => (
            <rect
              class:list={['win', { 'is-office': l.kind === 'office' }]}
              x={l.x}
              y={l.y}
              width={l.w}
              height={l.h}
              style={`--th:${l.th.toFixed(3)}`}
            />
          ))
      }
      {
        street.map((p) => (
          <g class="lamp" style={`--th:${p.th.toFixed(3)}`}>
            <circle cx={p.x} cy={H - 7} r="7" fill="url(#lamp-glow)" />
            <circle cx={p.x} cy={H - 7} r="1.4" />
          </g>
        ))
      }
    </svg>
  </div>
</section>
