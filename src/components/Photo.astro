---
/*
 * A photo from src/assets/photos, by file name without the extension. If the
 * file isn't there yet, production leaves the slot out and dev shows where
 * it goes.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG}', {
  eager: true,
});

interface Props {
  name: string;
  alt: string;
  sizes: string;
  /** Crop as a CSS aspect ratio, such as "3 / 2". */
  ratio?: string;
  /** Which part of the photo the crop keeps. */
  focus?: string;
  class?: string;
}

const { name, alt, sizes, ratio = '4 / 5', focus = '50% 40%', class: cls } = Astro.props;
const entry = Object.entries(files).find(([path]) => path.split('/').pop()?.replace(/\.[^.]+$/, '') === name);
const img = entry?.[1].default;
const dev = import.meta.env.DEV;
const widths = img ? [480, 720, 960, 1280, 1600, 2000].filter((w) => w <= img.width) : [];
---

{
  img ? (
    <div class:list={['photo', cls]} style={`--ratio:${ratio};--focus:${focus}`}>
      <Image src={img} alt={alt} widths={widths} sizes={sizes} format="webp" quality={80} loading="lazy" decoding="async" />
    </div>
  ) : (
    dev && (
      <div class:list={['photo', 'is-missing', cls]} style={`--ratio:${ratio}`} aria-hidden="true">
        <span>src/assets/photos/{name}.jpg</span>
      </div>
    )
  )
}
